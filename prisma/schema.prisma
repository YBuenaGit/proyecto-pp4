generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sessions               Session[]
  dispatchRecords        DispatchRecord[]        @relation("DispatchCreatedBy")
  dispatchFollowUps      DispatchFollowUp[]      @relation("DispatchFollowUpCreatedBy")
  juridicalInterventions JuridicalIntervention[] @relation("JuridicalCreatedBy")
  juridicalActions       JuridicalAction[]       @relation("JuridicalActionCreatedBy")
  referralsMade          Referral[]              @relation("ReferralReferredBy")
  internalExpedients     InternalExpedient[]     @relation("ExpedientCreatedBy")
  attachments            Attachment[]            @relation("AttachmentUploadedBy")
  auditLogs              AuditLog[]              @relation("AuditCreatedBy")
  catalogItems           CatalogItem[]           @relation("CatalogCreatedBy")
  appointmentsCreated    Appointment[]           @relation("AppointmentCreatedBy")
  personalAppointments   Appointment[]           @relation("AppointmentOwner")
  assignedAppointments   Appointment[]           @relation("AppointmentAssignedUser")
  lawyerAppointments     Appointment[]           @relation("AppointmentAssignedLawyer")
  retentionsCreated      Retention[]             @relation("RetentionCreatedBy")
  retentionHistories     RetentionHistory[]      @relation("RetentionEditedBy")
  retentionAttachments   RetentionAttachment[]   @relation("RetentionAttachmentUploadedBy")
  notificationReads      NotificationRead[]

  @@index([role])
  @@index([active])
}

model NotificationRead {
  id              String   @id @default(cuid())
  userId          String
  notificationKey String
  readAt          DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId])
  @@index([notificationKey])
  @@index([readAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExternalPerson {
  id                 String   @id @default(cuid())
  dni                String?  @unique
  firstName          String
  lastName           String
  fullNameNormalized String
  phone1             String?
  phone2             String?
  address            String?
  notes              String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  dispatchRecords        DispatchRecord[]
  juridicalInterventions JuridicalIntervention[]

  @@index([fullNameNormalized])
  @@index([lastName])
}

model DispatchRecord {
  id                 String    @id @default(cuid())
  internalNumber     String    @unique
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  attendedAt         DateTime  @default(now()) @db.Timestamptz(3)
  usesHistoricalDate Boolean   @default(false)
  createdById        String
  personId           String?
  dniSnapshot        String?
  nameSnapshot       String?
  description        String
  initialGuidance    String?
  confidentialNotes  String?
  deadlineAt         DateTime? @db.Timestamptz(3)
  category           String
  priority           String    @default("MEDIA")
  status             String    @default("RECIBIDO")
  referredArea       String?
  origin             String    @default("DIRECT")
  lastStatusAt       DateTime  @default(now()) @db.Timestamptz(3)

  createdBy            User                   @relation("DispatchCreatedBy", fields: [createdById], references: [id])
  person               ExternalPerson?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  complainants         DispatchComplainant[]
  linkedPersons        DispatchLinkedPerson[]
  followUps            DispatchFollowUp[]
  originReferrals      Referral[]             @relation("OriginDispatch")
  destinationReferrals Referral[]             @relation("DestinationDispatch")

  @@index([createdAt])
  @@index([attendedAt])
  @@index([category])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([personId])
  @@index([deadlineAt])
}

model DispatchComplainant {
  id               String   @id @default(cuid())
  dispatchRecordId String
  sortOrder        Int      @default(0)
  isAnonymous      Boolean  @default(false)
  dni              String?
  firstName        String?
  lastName         String?
  phone1           String?
  phone2           String?
  address          String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Cascade)

  @@index([dispatchRecordId])
  @@index([dni])
  @@index([firstName])
  @@index([lastName])
}

model DispatchLinkedPerson {
  id                  String   @id @default(cuid())
  dispatchRecordId    String
  sortOrder           Int      @default(0)
  dni                 String?
  firstName           String?
  apellidoApodoManual String?
  phone1              String?
  phone2              String?
  address             String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Cascade)

  @@index([dispatchRecordId])
  @@index([dni])
  @@index([firstName])
  @@index([apellidoApodoManual])
}

model DispatchFollowUp {
  id               String    @id @default(cuid())
  dispatchRecordId String
  content          String
  statusAfter      String?
  deadlineAt       DateTime? @db.Timestamptz(3)
  createdById      String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  dispatchRecord DispatchRecord @relation(fields: [dispatchRecordId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("DispatchFollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([dispatchRecordId])
  @@index([createdById])
  @@index([createdAt])
  @@index([deadlineAt])
}

model JuridicalIntervention {
  id                     String    @id @default(cuid())
  internalNumber         String    @unique
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  attendedAt             DateTime  @default(now()) @db.Timestamptz(3)
  createdById            String
  personId               String?
  dniSnapshot            String?
  nameSnapshot           String?
  complainantIsAnonymous Boolean   @default(false)
  complainantDni         String?
  complainantFirstName   String?
  complainantLastName    String?
  complainantPhone1      String?
  complainantPhone2      String?
  complainantAddress     String?
  type                   String
  subType                String?
  urgency                String    @default("MEDIA")
  status                 String    @default("RECIBIDO")
  oficioNumber           String?
  expedienteNumber       String?
  interventionContext    String?
  counterpartType        String?
  description            String
  guidanceProvided       String?
  referredToAgency       String?
  derivedArea            String?
  confidentialNotes      String?
  deadlineAt             DateTime? @db.Timestamptz(3)
  origin                 String    @default("DIRECT")
  lastStatusAt           DateTime  @default(now()) @db.Timestamptz(3)

  createdBy            User                    @relation("JuridicalCreatedBy", fields: [createdById], references: [id])
  person               ExternalPerson?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  complainants         JuridicalComplainant[]
  linkedPersons        JuridicalLinkedPerson[]
  actions              JuridicalAction[]
  originReferrals      Referral[]              @relation("OriginJuridical")
  destinationReferrals Referral[]              @relation("DestinationJuridical")

  @@index([createdAt])
  @@index([attendedAt])
  @@index([type])
  @@index([status])
  @@index([urgency])
  @@index([oficioNumber])
  @@index([expedienteNumber])
  @@index([createdById])
  @@index([personId])
  @@index([complainantDni])
  @@index([deadlineAt])
}

model JuridicalComplainant {
  id                      String   @id @default(cuid())
  juridicalInterventionId String
  sortOrder               Int      @default(0)
  isAnonymous             Boolean  @default(false)
  dni                     String?
  firstName               String?
  lastName                String?
  phone1                  String?
  phone2                  String?
  address                 String?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  juridicalIntervention JuridicalIntervention @relation(fields: [juridicalInterventionId], references: [id], onDelete: Cascade)

  @@index([juridicalInterventionId])
  @@index([dni])
  @@index([firstName])
  @@index([lastName])
}

model JuridicalLinkedPerson {
  id                      String   @id @default(cuid())
  juridicalInterventionId String
  sortOrder               Int      @default(0)
  dni                     String?
  firstName               String?
  apellidoApodoManual     String?
  phone1                  String?
  phone2                  String?
  address                 String?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  juridicalIntervention JuridicalIntervention @relation(fields: [juridicalInterventionId], references: [id], onDelete: Cascade)

  @@index([juridicalInterventionId])
  @@index([dni])
  @@index([firstName])
  @@index([apellidoApodoManual])
}

model JuridicalAction {
  id                      String    @id @default(cuid())
  juridicalInterventionId String
  actionType              String
  content                 String
  nextStepDate            DateTime? @db.Timestamptz(3)
  deadlineAt              DateTime? @db.Timestamptz(3)
  createdById             String
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)

  juridicalIntervention JuridicalIntervention @relation(fields: [juridicalInterventionId], references: [id], onDelete: Cascade)
  createdBy             User                  @relation("JuridicalActionCreatedBy", fields: [createdById], references: [id])

  @@index([juridicalInterventionId])
  @@index([actionType])
  @@index([nextStepDate])
  @@index([deadlineAt])
  @@index([createdById])
  @@index([createdAt])
}

model Referral {
  id                                 String    @id @default(cuid())
  originModule                       String
  destinationModule                  String
  originDispatchRecordId             String?
  originJuridicalInterventionId      String?
  destinationDispatchRecordId        String?
  destinationJuridicalInterventionId String?
  summary                            String
  status                             String    @default("PENDIENTE")
  visibleStatusForOrigin             String    @default("Pendiente de recepción")
  referredById                       String
  referredAt                         DateTime  @default(now()) @db.Timestamptz(3)
  closedAt                           DateTime? @db.Timestamptz(3)
  createdAt                          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime  @updatedAt @db.Timestamptz(3)

  referredBy                       User                   @relation("ReferralReferredBy", fields: [referredById], references: [id])
  originDispatchRecord             DispatchRecord?        @relation("OriginDispatch", fields: [originDispatchRecordId], references: [id], onDelete: SetNull)
  originJuridicalIntervention      JuridicalIntervention? @relation("OriginJuridical", fields: [originJuridicalInterventionId], references: [id], onDelete: SetNull)
  destinationDispatchRecord        DispatchRecord?        @relation("DestinationDispatch", fields: [destinationDispatchRecordId], references: [id], onDelete: SetNull)
  destinationJuridicalIntervention JuridicalIntervention? @relation("DestinationJuridical", fields: [destinationJuridicalInterventionId], references: [id], onDelete: SetNull)

  @@index([originModule])
  @@index([destinationModule])
  @@index([status])
  @@index([referredAt])
  @@index([originDispatchRecordId])
  @@index([originJuridicalInterventionId])
  @@index([destinationDispatchRecordId])
  @@index([destinationJuridicalInterventionId])
}

model InternalExpedient {
  id               String    @id @default(cuid())
  internalNumber   String    @unique
  expedienteNumber String?
  codigo           String?
  category         String
  area             String?
  description      String
  observation      String?
  deadlineAt       DateTime? @db.Timestamptz(3)
  status           String    @default("INICIADO")
  createdById      String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  createdBy User @relation("ExpedientCreatedBy", fields: [createdById], references: [id])

  @@index([codigo])
  @@index([category])
  @@index([area])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([expedienteNumber])
  @@index([deadlineAt])
}

model Appointment {
  id               String   @id @default(cuid())
  title            String
  date             String
  startTime        String
  endTime          String?
  calendarScope    String
  ownerUserId      String?
  createdByUserId  String
  assignedUserId   String?
  assignedLawyerId String?
  assignedArea     String?
  clientName       String?
  lawyerName       String?
  type             String
  status           String   @default("PENDIENTE")
  location         String?
  notes            String?
  caseId           String?
  caseTitle        String?
  expedienteNumber String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  owner          User? @relation("AppointmentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy      User  @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])
  assignedUser   User? @relation("AppointmentAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedLawyer User? @relation("AppointmentAssignedLawyer", fields: [assignedLawyerId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([calendarScope, date])
  @@index([ownerUserId, date])
  @@index([createdByUserId])
  @@index([assignedUserId])
  @@index([assignedLawyerId])
  @@index([assignedArea])
  @@index([type])
  @@index([status])
  @@index([expedienteNumber])
}

model Attachment {
  id                String   @id @default(cuid())
  module            String
  entityType        String
  entityId          String
  fileName          String
  originalName      String
  objectKey         String   @unique
  encryptionVersion Int      @default(1)
  mimeType          String
  size              Int
  isPrivate         Boolean  @default(false)
  uploadedById      String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  uploadedBy User @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([module])
  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([createdAt])
}

model Retention {
  id               String    @id @default(cuid())
  internalNumber   String    @unique
  dateTime         DateTime  @default(now()) @db.Timestamptz(3)
  actCreatedAt     DateTime? @db.Timestamptz(3)
  sentToTribunalAt DateTime? @db.Timestamptz(3)
  actNumber        String
  actType          String
  recordNumber     String
  domain           String?
  engineNumber     String?
  chassisNumber    String?
  vehicleType      String
  brand            String
  color            String
  description      String
  status           String    @default("PENDIENTE")
  createdById      String
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  createdBy   User                  @relation("RetentionCreatedBy", fields: [createdById], references: [id])
  histories   RetentionHistory[]
  attachments RetentionAttachment[]

  @@index([dateTime])
  @@index([actNumber])
  @@index([recordNumber])
  @@index([domain])
  @@index([engineNumber])
  @@index([chassisNumber])
  @@index([status])
  @@index([createdById])
}

model RetentionHistory {
  id          String   @id @default(cuid())
  retentionId String
  field       String
  oldValue    String?
  newValue    String?
  editedById  String
  editedAt    DateTime @default(now()) @db.Timestamptz(3)

  retention Retention @relation(fields: [retentionId], references: [id], onDelete: Cascade)
  editedBy  User      @relation("RetentionEditedBy", fields: [editedById], references: [id])

  @@index([retentionId])
  @@index([editedById])
  @@index([editedAt])
}

model RetentionAttachment {
  id                String   @id @default(cuid())
  retentionId       String
  objectKey         String   @unique
  encryptionVersion Int      @default(1)
  fileName          String
  originalName      String
  mimeType          String
  size              Int
  uploadedById      String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  retention  Retention @relation(fields: [retentionId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("RetentionAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([retentionId])
  @@index([uploadedById])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  module      String
  entityType  String
  entityId    String
  action      String
  beforeJson  String?
  afterJson   String?
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  createdBy User? @relation("AuditCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdById])
  @@index([createdAt])
}

model CatalogItem {
  id          String   @id @default(cuid())
  type        String
  module      String?
  value       String
  label       String
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  createdBy User? @relation("CatalogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([module])
  @@index([value])
  @@index([active])
}
